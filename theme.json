{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "740px",
			"wideSize": "1200px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"customGradient": true,
			"link": true,
			"palette": [
				{ "slug": "primary", "color": "#000000", "name": "Primary" },
				{ "slug": "primary-light", "color": "#000000", "name": "Primary Light" },
				{ "slug": "secondary", "color": "#000000", "name": "Secondary" },
				{ "slug": "accent", "color": "#000000", "name": "Accent" },
				{ "slug": "base", "color": "#ffffff", "name": "Base (Background)" },
				{ "slug": "base-2", "color": "#ffffff", "name": "Base 2 (Surface)" },
				{ "slug": "contrast", "color": "#000000", "name": "Contrast (Text)" },
				{ "slug": "contrast-2", "color": "#000000", "name": "Contrast 2 (Muted)" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"customFontSize": true,
			"fluid": true,
			"lineHeight": true,
			"letterSpacing": true,
			"textTransform": true,
			"writingMode": true,
			"fontFamilies": [
				{
					"slug": "heading",
					"name": "Heading",
					"fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif",
					"fontFace": []
				},
				{
					"slug": "body",
					"name": "Body",
					"fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif",
					"fontFace": []
				}
			],
			"fontSizes": [
				{ "slug": "xs", "name": "XS", "size": "0.75rem", "fluid": { "min": "0.75rem", "max": "0.8125rem" } },
				{ "slug": "sm", "name": "SM", "size": "0.875rem", "fluid": { "min": "0.875rem", "max": "0.9375rem" } },
				{ "slug": "base", "name": "Base", "size": "1rem", "fluid": { "min": "1rem", "max": "1.125rem" } },
				{ "slug": "md", "name": "MD", "size": "1.25rem", "fluid": { "min": "1.125rem", "max": "1.375rem" } },
				{ "slug": "lg", "name": "LG", "size": "1.5rem", "fluid": { "min": "1.375rem", "max": "1.75rem" } },
				{ "slug": "xl", "name": "XL", "size": "2rem", "fluid": { "min": "1.75rem", "max": "2.5rem" } },
				{ "slug": "2xl", "name": "2XL", "size": "3rem", "fluid": { "min": "2.25rem", "max": "3.75rem" } },
				{ "slug": "3xl", "name": "3XL", "size": "4.5rem", "fluid": { "min": "3rem", "max": "6rem" } }
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"customSpacingSize": true,
			"units": [ "px", "em", "rem", "vh", "vw", "%" ],
			"spacingSizes": [
				{ "slug": "1", "name": "1", "size": "0.25rem" },
				{ "slug": "2", "name": "2", "size": "0.5rem" },
				{ "slug": "3", "name": "3", "size": "0.75rem" },
				{ "slug": "4", "name": "4", "size": "1rem" },
				{ "slug": "5", "name": "5", "size": "1.5rem" },
				{ "slug": "6", "name": "6", "size": "2rem" },
				{ "slug": "7", "name": "7", "size": "3rem" },
				{ "slug": "8", "name": "8", "size": "4rem" },
				{ "slug": "9", "name": "9", "size": "6rem" },
				{ "slug": "10", "name": "10", "size": "8rem" }
			]
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--base)",
			"lineHeight": "1.6"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"lineHeight": "1.1",
					"fontWeight": "700"
				}
			},
			"link": {
				"color": { "text": "var(--wp--preset--color--contrast)" },
				":hover": {
					"color": { "text": "var(--wp--preset--color--primary)" }
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--base)"
				},
				"border": { "radius": "0" },
				"spacing": {
					"padding": {
						"top": "var(--wp--preset--spacing--3)",
						"bottom": "var(--wp--preset--spacing--3)",
						"left": "var(--wp--preset--spacing--5)",
						"right": "var(--wp--preset--spacing--5)"
					}
				},
				":hover": {
					"color": { "background": "var(--wp--preset--color--primary-light)" }
				}
			}
		},
		"blocks": {
			"core/group": {
				"spacing": {
					"margin": { "top": "0", "bottom": "0" }
				}
			},
			"core/columns": {
				"spacing": {
					"margin": { "top": "0", "bottom": "0" }
				}
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": []
}
